{
  "name": "futuristikzone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-feeds.mjs && node scripts/validate-export.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "recover": "node scripts/archive/recover.mjs",
    "audit:archive": "node scripts/archive/inspect.mjs",
    "preview": "node scripts/serve.mjs",
    "recover:all": "npm run recover && node scripts/archive/supplement.mjs && npm run recover && node scripts/archive/recover-assets.mjs && node scripts/archive/catalog.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.1.2",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
